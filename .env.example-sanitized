#Replace this with your actual .env file with your required API keys and secrets, but do not push
#that file to public repos, just this template.  gitignore will ignore .env itself. These are sanitized/common/generic values.

# ZMQ rawblock endpoint (must match your bitcoin.conf zmqpubrawblock)
ZMQ_RAWBLOCK=tcp://127.0.0.1:28332

# Watch this versionbits bit (use bit-4 for the current BIP110 'reduced data' UASF acceptance signaling)
WATCH_BIT=4

# bitcoin-cli + config
BITCOIN_CLI=/usr/local/bin/bitcoin-cli
BITCOIN_CONF=/home/bitcoin/.bitcoin/bitcoin.conf

# state file to avoid duplicate alerts on restarts
STATE_FILE=/home/bitcoin/monitoring/bip110/state.json

# logging
LOG_LEVEL=INFO

# Desktop toast bridge (Windows listener)
DESKTOP_TOAST_URL=http://192.168.1.89:8099/
STARTUP_TOAST=1
TOAST_EVERY_BLOCK=1

# Phone alerts (Pushover)
STARTUP_PUSHOVER=1
PUSHOVER_USER=REPLACE_ME
PUSHOVER_TOKEN=REPLACE_ME
PUSHOVER_SOUND=siren
PUSHOVER_RETRY=60
PUSHOVER_EXPIRE=3600

# Liveness (optional): every N blocks, 144 blocks = ~1 day
HEARTBEAT_EVERY_N_BLOCKS=144
HEARTBEAT_TO_PUSHOVER=1
HEARTBEAT_TO_DESKTOP=1
